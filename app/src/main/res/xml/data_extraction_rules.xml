<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Wellness data is excluded from cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="wellness.db" />
        <exclude domain="database" path="wellness.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="wellness.db" />
        <exclude domain="database" path="wellness.db-journal" />
    </device-transfer>
</data-extraction-rules>
